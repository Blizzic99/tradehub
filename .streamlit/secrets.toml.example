# Template only - real values never go in this file or anywhere in the repo.
#
# Recommended location for the real file: ~/.streamlit/secrets.toml (Windows:
# C:\Users\<you>\.streamlit\secrets.toml). That keeps keys outside the repo AND outside any
# OneDrive/Dropbox-synced folder, and both `streamlit run` (st.secrets) and the headless tools
# (scan_alert.py, alpha_backtest.py) find it from any working directory. `.streamlit/secrets.toml`
# next to the app also works and is git-ignored. On Streamlit Community Cloud, paste these lines
# into the app's Settings -> Secrets instead.
#
# Credentials are NEVER entered in the dashboard UI.

POLYGON_KEY = "your_polygon_api_key_here"
TELEGRAM_BOT_TOKEN = "your_telegram_bot_token_here"   # from @BotFather
TELEGRAM_CHAT_ID = "your_telegram_chat_id_here"       # numeric ID from @userinfobot

# Alerts on/off for sessions that are NOT the owner's local run (e.g. the public cloud app).
# Visitors can never change it. The on/off checkbox appears only in a local session bound to
# localhost (tradehub.bat). Leave false on a public deployment and use `python scan_alert.py --send`
# for alerts, so visitor traffic never triggers messages.
TELEGRAM_ALERTS_ENABLED = false
