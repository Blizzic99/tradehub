# Copy this file to `secrets.toml` in the same folder and fill in your real values.
# `secrets.toml` is git-ignored, so your keys never get committed.
# Loaded via st.secrets in the scanner's _secret() helper (falls back to env vars).

POLYGON_KEY = "your_polygon_api_key_here"
TELEGRAM_BOT_TOKEN = "your_telegram_bot_token_here"   # from @BotFather
TELEGRAM_CHAT_ID = "your_telegram_chat_id_here"       # numeric ID from @userinfobot
